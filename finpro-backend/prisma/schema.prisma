// FinProMatch — Prisma schema
// Mirrors the data model built in the frontend prototype 1:1 so migrating
// off window.storage is mechanical rather than a redesign. Postgres (Neon).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- enums ----------

enum UserRole {
  CLIENT
  PROFESSIONAL
}

enum FirmCapacity {
  SMALL
  MEDIUM
  LARGE
  ENTERPRISE
}

enum FirmAvailability {
  ACCEPTING
  LIMITED
  FULLY_BOOKED
}

enum FirmVerificationStatus {
  PENDING
  VERIFIED
  INFO_REQUIRED
  REJECTED
}

enum EngagementSensitivity {
  STANDARD
  CONFIDENTIAL
  HIGH
  HIGHLY_SENSITIVE
}

enum EngagementStatus {
  NEW
  UNDER_REVIEW
  MATCHING
  FIRM_SELECTED
  INTRODUCTION_SENT
  CLIENT_ACCEPTED
  FIRM_ACCEPTED
  ACTIVE
  COMPLETED
  DECLINED
  CLOSED
  REMATCH
}

enum MessageSenderRole {
  CLIENT
  FIRM
  ADMIN
}

enum LeadStatus {
  PENDING
  MATCHED
  ENGAGED
  PAID
  DELIVERED
  RELEASED
}

/// Kinds of in-app notification. Each maps to one of the trigger points
/// wired up in src/routes/admin.engagements.js, admin.firms.js, and messages.js.
enum NotificationType {
  ENGAGEMENT_MATCHED
  FIRM_VERIFIED
  FIRM_INFO_REQUIRED
  FIRM_REJECTED
  MESSAGE_RECEIVED
}

enum GuestBriefStatus {
  NEW
  CONTACTED
  CONVERTED
  CLOSED
}

/// Status of the one-off match fee a client pays to unlock a matched firm's
/// contact details on an Engagement. PENDING covers the window between
/// starting a Paystack transaction and it clearing (success, webhook, or the
/// client abandoning it) — FAILED means Paystack itself reported failure,
/// not "hasn't paid yet" (that's UNPAID). RELEASED is an admin bookkeeping
/// step after PAID, same shape as the individual-professional track: funds
/// are held by FinProMatch at PAID and admin releases them to the firm —
/// contact details unlock at PAID already, RELEASED doesn't gate anything.
enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  RELEASED
  FAILED
}

// ---------- models ----------

/// Individual users — both clients and individual professionals (legacy track).
/// role distinguishes the two; professional-only fields are nullable for clients.
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  /// Set only for accounts created or linked via "Continue with Google" —
  /// null for accounts that only ever used email/password.
  googleId     String?  @unique
  role         UserRole
  name         String
  phone        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // professional-only fields (legacy individual-professional track)
  professionalBody   String?
  registrationNumber String?
  yearsExperience    String?
  expertise          String?
  rate               String?
  bio                String?
  verified           Boolean @default(false)

  engagements   Engagement[]
  leads         Lead[]
  messages      Message[]
  notifications Notification[]

  @@map("users")
}

/// Accounting/tax/advisory firms — separate auth track from individual users.
model Firm {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  /// Set only for accounts created or linked via "Continue with Google" —
  /// null for accounts that only ever used email/password.
  googleId     String?  @unique
  firmName     String
  phone        String?
  logoInitials String?
  website      String?
  yearEstablished String?

  headquarters    String?
  citiesServed    String[] @default([])
  statesServed    String[] @default([])
  countriesServed String[] @default([])
  remoteAvailable Boolean  @default(false)

  description String? @db.Text

  // professional credentials
  credentialIcan    String?
  credentialAnan    String?
  credentialCitn    String?
  credentialOther   String?
  verificationDocs  String? @db.Text

  // taxonomy — kept as string arrays so new categories can be added without a migration
  specialisations String[] @default([])
  industries      String[] @default([])

  capacity     FirmCapacity     @default(SMALL)
  availability FirmAvailability @default(ACCEPTING)

  verificationStatus     FirmVerificationStatus @default(PENDING)
  verifyIdentity         Boolean                @default(false)
  verifyCredentials      Boolean                @default(false)
  verifyFirm             Boolean                @default(false)
  verifiedSpecialisations String[]              @default([])
  adminNotes             String?                @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages      Message[]
  notifications Notification[]

  @@map("firms")
}

/// Firm-matching engagement requests — the core marketplace flow.
/// Manual matching only: selectedFirmIds and matchReasonNote are set by an
/// admin, never by an automated scoring engine.
model Engagement {
  id      String @id @default(uuid())
  refCode String @unique

  client      User   @relation(fields: [clientId], references: [id])
  clientId    String
  clientName  String
  clientEmail String
  clientPhone String?

  company      String?
  industry     String
  businessSize String

  engagementType String
  /// Array of { id, label, value } — dynamic per-type follow-up answers.
  typeAnswers    Json?

  details String @db.Text

  deadline         DateTime?
  estimatedValue   String?
  expectedDuration String?

  country        String?
  state          String?
  city           String?
  onSiteRequired Boolean @default(false)

  sensitivity EngagementSensitivity @default(STANDARD)
  status      EngagementStatus      @default(NEW)

  /// Firms an admin has manually selected for this engagement.
  selectedFirmIds String[] @default([])
  matchReasonNote String?  @db.Text

  /// Set when a client requests a match "with this firm in mind" from a firm profile.
  interestedFirmId String?

  /// Whole-naira match fee an admin sets once a firm is matched — what the
  /// client pays to unlock that firm's direct contact details. Null until
  /// admin sets one.
  feeAmount      Int?
  paymentStatus  PaymentStatus @default(UNPAID)
  /// Set once a Paystack transaction for this engagement is confirmed PAID
  /// — via the client's post-checkout verify call or the webhook, whichever
  /// lands first.
  paidAt         DateTime?
  /// The reference we generate and hand to Paystack for the current/last
  /// payment attempt, so the verify call and the webhook can both find
  /// their way back to this row.
  paystackRef    String?       @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]

  @@map("engagements")
}

/// Shared per-engagement message thread. Visibility (who may read/post) is
/// enforced in the API layer, not by this table — see src/routes/messages.js.
model Message {
  id           String            @id @default(uuid())
  engagement   Engagement        @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  engagementId String
  senderRole   MessageSenderRole
  senderName   String
  body         String            @db.Text
  createdAt    DateTime          @default(now())

  // optional relations back to the actual sender account, when applicable
  senderUser   User? @relation(fields: [senderUserId], references: [id])
  senderUserId String?
  senderFirm   Firm? @relation(fields: [senderFirmId], references: [id])
  senderFirmId String?

  @@map("messages")
}

/// Legacy individual-professional track — request, match, contract, payment.
model Lead {
  id      String @id @default(uuid())
  refCode String @unique

  client   User   @relation(fields: [clientId], references: [id])
  clientId String
  name     String
  contact  String
  company  String?

  need    String
  budget  String?
  details String @db.Text

  status LeadStatus @default(PENDING)

  /// Ids of professionals offered to the client — a live reference, not a
  /// snapshot, mirroring the frontend's original by-id behavior.
  matches    String[] @default([])
  chosenPro  String?
  /// Whole-naira amount — arithmetic (commission calc), not free text.
  feeAmount  Int?
  scopeNote  String? @db.Text
  /// Set once POST /:id/pay runs (simulated payment — see README).
  paidAt     DateTime?

  rating Int?
  review String? @db.Text

  interestedFirmId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("leads")
}

/// Real admin accounts — replaces the hardcoded client-side passcode.
model Admin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())

  notifications Notification[]

  @@map("admins")
}

/// In-app notifications — client/firm/admin bell + notifications page.
/// Recipient is exactly one of the three optional relations below, matching
/// the same per-role-relation pattern Message already uses for its sender.
model Notification {
  id    String           @id @default(uuid())
  type  NotificationType
  title String
  body  String           @db.Text
  /// Optional pointer for the frontend to deep-link into — an engagement id,
  /// a firm id, etc. Interpreted client-side per notification type.
  link  String?
  read  Boolean          @default(false)

  recipientUser    User?   @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  recipientUserId  String?
  recipientFirm    Firm?   @relation(fields: [recipientFirmId], references: [id], onDelete: Cascade)
  recipientFirmId  String?
  recipientAdmin   Admin?  @relation(fields: [recipientAdminId], references: [id], onDelete: Cascade)
  recipientAdminId String?

  createdAt DateTime @default(now())

  @@index([recipientUserId, read])
  @@index([recipientFirmId, read])
  @@index([recipientAdminId, read])
  @@map("notifications")
}

/// A no-account-needed quick brief from a prospective client who doesn't
/// want to sign up first. Captured here AND emailed to the team inbox —
/// the row is the source of truth even if the email bounces or gets missed.
model GuestBrief {
  id        String           @id @default(uuid())
  name      String
  contact   String
  brief     String           @db.Text
  status    GuestBriefStatus @default(NEW)
  createdAt DateTime         @default(now())

  @@map("guest_briefs")
}
